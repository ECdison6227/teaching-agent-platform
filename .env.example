# 无模型也可完成导入与规则学习。配置通道后将 none 改为对应名称。
DATA_DIR=./data
# 导入命令超时（毫秒）；Poppler 实际预算为基础值 + 本次处理页数 × 每页值。
IMPORT_SOFFICE_TIMEOUT_MS=900000
IMPORT_PDFINFO_TIMEOUT_MS=120000
IMPORT_PDFTOPPM_TIMEOUT_MS=120000
IMPORT_PDFTOPPM_PER_PAGE_TIMEOUT_MS=30000
IMPORT_PDFTOTEXT_TIMEOUT_MS=120000
IMPORT_PDFTOTEXT_PER_PAGE_TIMEOUT_MS=10000
IMPORT_COMMAND_TIMEOUT_MS=120000
# 页图/文本提取、扫描页 OCR、逐页要点的并发上限，1–16。
IMPORT_PAGE_CONCURRENCY=4
# 按原题边界分批：每批 1–100 题；并发 1–16 批。
IMPORT_QUESTION_BATCH=10
IMPORT_QUESTION_CONCURRENCY=4
# 知识点关联最低模型置信度（0–1）；低于阈值显示未关联。
IMPORT_QUESTION_KP_THRESHOLD=0.7
# Provider 网络请求超时及普通网络错误退避（毫秒），普通网络重试 3 次。
MODEL_TIMEOUT_MS=120000
MODEL_RETRY_BASE_MS=500
# 429 单独重试预算（0–32），更长退避；Retry-After 秒数/HTTP 日期优先作为等待下限。
MODEL_RATE_LIMIT_RETRIES=8
MODEL_RATE_LIMIT_BASE_MS=5000
MODEL_RATE_LIMIT_MAX_MS=120000
# 同一进程内所有任务/模型共享通道调度；RPM=0 表示不预设速率上限。
# 请求平滑间隔发送，429 自动降低并发，连续成功且经过恢复窗口后每次回升 1。
MODEL_CONCURRENCY=4
MODEL_RPM=0
MODEL_RECOVERY_SUCCESSES=8
MODEL_RECOVERY_MS=30000
# 通道前缀覆盖上述 MODEL_* 值：SCHOOL / STEPFUN / AGNES / DEEPSEEK / OPENAI。
# 例如 AGNES_RPM=30、AGNES_CONCURRENCY=2、AGNES_RATE_LIMIT_RETRIES=10。
# 对话先校验节奏，违规最多请求一次重写（与初次生成共享总时限）。
# off 恢复逐 delta 输出；两种模式均由协议层限制首个问题、首张卡片和正文长度。
CHAT_PACING_REPAIR=on
MODEL_PROVIDER=none
# 可选：school / stepfun / agnes / deepseek / openai-compatible
# 各任务不填时沿用 MODEL_PROVIDER；VISION_MODEL_PROVIDER 没有可用配置时用文本。
# CHAT_MODEL_PROVIDER=deepseek
# STRUCTURE_MODEL_PROVIDER=deepseek
# NOTES_MODEL_PROVIDER=agnes
# TEXTBOOK_MODEL_PROVIDER=deepseek
# QUESTIONS_MODEL_PROVIDER=deepseek
# VISION_MODEL_PROVIDER=agnes
# 各任务可再覆盖模型名：CHAT_MODEL / STRUCTURE_MODEL / NOTES_MODEL / TEXTBOOK_MODEL / QUESTIONS_MODEL

# 通用 OpenAI 兼容服务，URL 以 /v1 等 API 前缀结束，不含 /chat/completions
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_VISION_BASE_URL=
OPENAI_VISION_API_KEY=
OPENAI_VISION_MODEL=

SCHOOL_CHAT_BASE_URL=
SCHOOL_CHAT_API_KEY=
SCHOOL_CHAT_MODEL=
SCHOOL_VISION_BASE_URL=
SCHOOL_VISION_API_KEY=
SCHOOL_VISION_MODEL=

STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_API_KEY=
STEPFUN_CHAT_MODEL=
STEPFUN_VISION_MODEL=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_CHAT_MODEL=
AGNES_VISION_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=
# DeepSeek 文本模型不支持视觉时，保持此项为空。
DEEPSEEK_VISION_MODEL=

# 子路径需在构建前设置，Next Link 与 API 请求均自动添加。
NEXT_PUBLIC_BASE_PATH=

# 默认自动尝试 json_object，不支持时降级；可按通道关闭，例如：
# AGNES_JSON_MODE=off
# OPENAI_JSON_MODE=off
# 可选独立构建目录；build 和 smoke 使用相同值，不覆盖正在运行服务的 .next。
# NEXT_DIST_DIR=.next-check

# 任务租约与挂起/时钟跳变保护（毫秒；正整数）
IMPORT_LEASE_MS=300000
IMPORT_HEARTBEAT_MS=10000
IMPORT_LEASE_GRACE_MS=300000
IMPORT_CLOCK_JUMP_MS=30000
